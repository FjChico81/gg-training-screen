{
  "name": "gg-mobile-ios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "ios:sync": "npm run build:web && npx cap sync ios && npm run ios:configure",
    "ios:open": "npx cap open ios",
    "test": "node --test tests/*.test.mjs",
    "ios:init": "npm run build:web && npx cap add ios && npm run ios:configure && npx cap sync ios",
    "ios:configure": "node scripts/configure-ios.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor-community/bluetooth-le": "^7.0.0",
    "@capacitor-community/keep-awake": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.25.0"
  }
}
